# Port server backend
PORT=4000

# Kunci penandatangan JWT. Ganti dengan string acak yang panjang sebelum deploy.
JWT_SECRET=studytrack-secret-key-change-this

# Buat database studytrack terlebih dahulu. URL-encode karakter khusus password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/studytrack

# Origin frontend yang diizinkan oleh CORS
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
